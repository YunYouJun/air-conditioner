{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm run react:build",
  "outputDirectory": "packages/react/dist",
  "headers": [
    { "source": "/widget/(.*)", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
